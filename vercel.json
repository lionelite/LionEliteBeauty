{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/send",
      "destination": "/api/email-health"
    },
    {
      "source": "/api/checkout-lock",
      "destination": "/api/email-health"
    },
    {
      "source": "/api/orders",
      "destination": "/api/email-health"
    },
    {
      "source": "/api/stripe-webhook",
      "destination": "/api/order-email-live-test"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/skincare/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/skincare/ghk-cu-serum",
      "destination": "https://lionelitewellness.com/skincare/ghk-cu-serum",
      "permanent": true
    },
    {
      "source": "/skincare/rejuvenate-serum",
      "destination": "https://lionelitewellness.com/skincare/ghk-cu-serum",
      "permanent": true
    },
    {
      "source": "/skincare",
      "destination": "/programs/optimization",
      "permanent": true
    },
    {
      "source": "/skincare/:path*",
      "destination": "/programs/optimization",
      "permanent": true
    },
    {
      "source": "/ingredients",
      "destination": "/programs/optimization",
      "permanent": true
    },
    {
      "source": "/ingredients/:path*",
      "destination": "/programs/optimization",
      "permanent": true
    },
    {
      "source": "/start-here",
      "destination": "/programs/optimization",
      "permanent": true
    },
    {
      "source": "/skin-system",
      "destination": "/programs/optimization",
      "permanent": true
    },
    {
      "source": "/cart",
      "destination": "/programs/optimization",
      "permanent": true
    },
    {
      "source": "/checkout",
      "destination": "/programs/optimization",
      "permanent": true
    }
  ]
}
