# Stripe — live keys (get from https://dashboard.stripe.com/apikeys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...

# Resend — email sending (get from https://resend.com/api-keys)
RESEND_API_KEY=re_...
# ── Security / auth (REQUIRED — all fail closed if unset) ──────────────────
# Admin dashboard login. No defaults exist in code; unset = login disabled.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
# Privileged API token for /api/vip admin actions. Must be >=16 chars.
# Unset = privileged endpoints return 503 rather than accepting a default.
ADMIN_TOKEN=

# Sales-rep credentials as JSON, e.g.
# {"colin":{"name":"Colin","code":"COLIN10","password":"..."}}
REP_CREDENTIALS=

# Where new-order notifications are delivered.
ORDER_NOTIFICATION_EMAIL=

# Durable storage (REQUIRED). VIP/coaching accounts refuse to save without it.
KV_REST_API_TOKEN=
KV_URL=
